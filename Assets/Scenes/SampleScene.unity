  m_Script: {fileID: 11500000, guid: 681b1ca1afac96048aa76e4f38c6dbe4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjectRecolect
  dialogueLines:
  - "He conseguido una semilla, se ve muy peculiar. Parece que se modific\xF3 para
    un crecimiento r\xE1pido."
  - Si tan solo tuviera un poco de agua pudiera ver el como creece.
  - .....
  - "Me pregunto el por qu\xE9 la quer\xEDa el robot."
  - "Bueno me la llevar\xE9 y espero pronto encontrar un lugar en donde plantarla,
    a lo mejor y puede ayudar al planeta."
  dialoguePanel: {fileID: 1652079598}
  playerUI: {fileID: 619025763}
  spriteSecondary: {fileID: 2077174063}
  textKetInteract: {fileID: 826097830}
  dialogueTextPanel: {fileID: 1370612337}
