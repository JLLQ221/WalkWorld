PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1652079598}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogueTextPanel
      value: 
      objectReference: {fileID: 1370612337}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "\xBFQu\xE9 es lo que veo?"
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "Parece ser otro robot pero tambi\xE9n hay otro objeto a su lado."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: ....
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "Parece que el robot est\xE1 cuidando del objeto y no logro ver que
        es."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "Me acercar\xE9 un poco; espero que no me vea."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: "\xA1 Esquive ese golpe por los pelos !"
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: Parece que tendre que derrotar al robot para poder tomar el objeto.
      objectReference: {fileID: 0}
    - target: {fileID: 5847797827022252653, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: m_LocalPosition.x
      value: 13.13325
