      propertyPath: dialogos.Array.data[0].dialogueLine
      value: "\xBFEn donde estoy?"
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[10].actorTalkin
