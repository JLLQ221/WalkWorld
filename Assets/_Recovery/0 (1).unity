    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[7].actorTalkin
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[8].actorTalkin
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[9].actorTalkin
      value: IA
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[0].dialogueLine
      value: "\xBFQu\xE9 es eso?"
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[10].actorTalkin
      value: IA
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[11].actorTalkin
      value: IA
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[12].actorTalkin
      value: Anna
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[13].actorTalkin
      value: Anna
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[1].dialogueLine
      value: Parece un robot.
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[2].dialogueLine
      value: Escaneando...
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[3].dialogueLine
      value: "Es correcto se\xF1orita Anna es un robot."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[4].dialogueLine
      value: Aunque este se encuentra en un mal estado.
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[5].dialogueLine
      value: Tratare de acercarme para poder pedir su ayuda.
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[6].dialogueLine
      value: "\xA1Por suerte esquive ese disparo!"
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[7].dialogueLine
      value: No creo que se pueda razonar con este robot.
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[8].dialogueLine
      value: "\xBFYara se puede reparar o hacer algo ?"
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[9].dialogueLine
      value: "Lo siento se\xF1orita Anna pero no creo que se pueda arreglar o razonar
        con el."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[10].dialogueLine
      value: "Su estado tan deplorable a hecho que su programaci\xF3n y l\xF3gica
        falle."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[11].dialogueLine
      value: Lo bueno es que sus <color=green><b>piezas</b></color> se pueden ocupar
        para reparar la nave.
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[12].dialogueLine
      value: "Tienes raz\xF3n, podemos ocupar sus <color=green><b>piezas</b></color>
        para la reparaci\xF3n de la nave."
      objectReference: {fileID: 0}
    - target: {fileID: 4839105773005779062, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: dialogos.Array.data[13].dialogueLine
      value: Tendre que machacarlo a <color=red><b>disparos</b></color>
      objectReference: {fileID: 0}
    - target: {fileID: 5847797827022252653, guid: 506240635e7c4bc4490f95f2776e0744, type: 3}
      propertyPath: m_LocalPosition.x
      value: 12.3173
