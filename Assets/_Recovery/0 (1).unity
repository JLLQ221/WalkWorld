  m_EditorClassIdentifier: Assembly-CSharp::ObjectRecolect
  dialogos:
  - actor: 0
    dialogueLine: Parce ser una <color=green><b>semilla</b></color>, pero tiene algo
      especial.
    delay: 0.05
  - actor: 0
    dialogueLine: "\xBFPuedes escanearla Yara?"
    delay: 0.05
  - actor: 1
    dialogueLine: Escaneando...
    delay: 0.1
  - actor: 1
    dialogueLine: "Parece una <color=green><b>semilla</b></color> modificada para
      crecimiento r\xE1pido."
    delay: 0.05
  - actor: 0
    dialogueLine: "Me pregunto el por qu\xE9 el robot lo estaria cuidando."
    delay: 0.05
  - actor: 0
    dialogueLine: Espero encontrar un lugar para darle agua.
    delay: 0.05
  playerUI: {fileID: 619025763}
  spriteSecondary: {fileID: 2077174063}
  spritePrimary: {fileID: 0}
  textKetInteract: {fileID: 826097830}
